{
  "name": "elara",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "turbo run dev --filter=@elara/mobile",
    "dev:api": "turbo run dev --filter=@elara/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "apps/api/**/*.{ts,js}": [
      "eslint --fix --config apps/api/eslint.config.js"
    ],
    "apps/mobile/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --config apps/mobile/eslint.config.js"
    ],
    "packages/**/*.{ts,tsx,js,jsx,cjs}": [
      "eslint --fix --config eslint.config.js"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
